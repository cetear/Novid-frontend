{
  "name": "novid-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "build": "vue-tsc --build && vite build",
    "lint": "eslint .",
    "format": "prettier --write src tests scripts *.ts *.json",
    "format:check": "prettier --check src tests scripts *.ts *.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test --project=contract",
    "test:e2e:live": "playwright test --project=live",
    "test:backend": "node scripts/check-backend.mjs",
    "docs:check": "node scripts/check-doc-links.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "dompurify": "^3.2.7",
    "element-plus": "^2.11.0",
    "eventsource-parser": "^3.0.6",
    "markdown-it": "^14.1.0",
    "pinia": "3.0.4",
    "vue": "3.5.42",
    "vue-router": "^4.6.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tsconfig/node24": "24.0.5",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "24.13.4",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.0",
    "jiti": "2.7.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "~6.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "8.3.2",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
}
